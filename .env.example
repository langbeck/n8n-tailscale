# ==========================================
# REQUIRED CONFIGURATION (Base)
# ==========================================
# Generate an auth key from your Tailscale Admin Console (Settings > Keys)
TAILSCALE_AUTH_KEY=tskey-auth-XXXXXXXXXXXXXXXXXXXX

# Your Tailscale root tailnet DNS domain name (e.g., your-tailnet.ts.net)
TAILSCALE_DNS_NAME=your-tailnet.ts.net

# ==========================================
# OPTIONAL CONFIGURATION (Base)
# Safe defaults applied if left blank.
# ==========================================
# Tailscale Hostname (Device Name in Tailscale Admin & Subdomain)
TAILSCALE_HOSTNAME=n8n-automation-node

# Container Image Versions
TAILSCALE_VERSION=latest
N8N_VERSION=latest

# Custom Obscured Webhook Endpoints
N8N_ENDPOINT_WEBHOOK=prod-secret-path
N8N_ENDPOINT_WEBHOOK_TEST=test-secret-path

# ==========================================
# OPTIONAL CONFIGURATION (Sandbox Companion)
# ==========================================
N8N_SANDBOX_VERSION=latest
